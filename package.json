{
  "name": "cosmosmart-citizen-portal-test-suite",
  "version": "1.0.0",
  "description": "Playwright test suite for the CosmoSmart citizen portal",
  "scripts": {
    "test": "playwright test",
    "test:home": "playwright test home.spec.ts",
    "test:auth": "playwright test auth-form.spec.ts",
    "test:landing": "playwright test landing.spec.ts",
    "test:headed": "playwright test --headed --workers=1",
    "test:ui": "playwright test --ui",
    "test:failed": "playwright test --last-failed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "main": "index.js"
}
